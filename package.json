{
  "name": "@blinkk/degu",
  "version": "3.2.2",
  "description": "A general utility library for interactive websites, with a focus on performance.",
  "author": "Blinkk <hello@blinkk.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkk/degu.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": {
      "default": "./lib/*"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib && NODE_OPTIONS=--max-old-space-size=4096 tsup",
    "build-watch": "tsup --watch",
    "clean": "rm -rf lib docs coverage examples/dist",
    "compile": "NODE_OPTIONS=--max-old-space-size=4096 tsup",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "doc": "typedoc",
    "examples": "vite build",
    "fix": "biome check --write src tsup.config.ts vite.config.ts vitest.config.ts",
    "format": "biome format --write src tsup.config.ts vite.config.ts vitest.config.ts",
    "lint": "biome check src tsup.config.ts vite.config.ts vitest.config.ts",
    "prepare": "npm run build",
    "server": "vite",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/angular": "1.8.9",
    "@types/angular-sanitize": "1.8.4",
    "@types/dat.gui": "0.7.13",
    "@types/node": "22.20.5",
    "@types/three": "0.103.2",
    "@types/youtube": "0.0.49",
    "@vitest/coverage-v8": "4.1.12",
    "dat.gui": "0.7.9",
    "happy-dom": "21.0.4",
    "lit": "3.3.3",
    "lottie-web": "5.13.0",
    "three": "0.110.0",
    "tsup": "9.0.0",
    "typedoc": "0.28.20",
    "typescript": "5.8.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  },
  "peerDependencies": {
    "angular": "*",
    "dat.gui": "*",
    "lit": "*",
    "lottie-web": "*",
    "pixi.js": "*",
    "three": "*"
  },
  "peerDependenciesMeta": {
    "angular": {
      "optional": true
    },
    "dat.gui": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "lottie-web": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}

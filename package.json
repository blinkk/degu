{
  "name": "@blinkk/degu",
  "version": "3.2.1",
  "description": "A general utility library for interactive websites, with a focus on performance.",
  "author": "Blinkk <hello@blinkk.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blinkk/degu.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lib/*": {
      "default": "./lib/*"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "rm -rf lib && tsup",
    "build-watch": "tsup --watch",
    "clean": "rm -rf lib docs coverage examples/dist",
    "compile": "tsup",
    "coverage": "vitest run --coverage",
    "dev": "vite",
    "doc": "typedoc",
    "examples": "vite build",
    "fix": "biome check --write src tsup.config.ts vite.config.ts vitest.config.ts",
    "format": "biome format --write src tsup.config.ts vite.config.ts vitest.config.ts",
    "lint": "biome check src tsup.config.ts vite.config.ts vitest.config.ts",
    "prepare": "npm run build",
    "server": "vite",
    "start": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@github/details-dialog-element": "^3.1.3",
    "@types/angular": "^1.8.4",
    "@types/angular-sanitize": "^1.7.0",
    "@types/dat.gui": "^0.7.12",
    "@types/jquery": "^3.5.32",
    "@types/node": "^22.13.0",
    "@types/three": "0.103.2",
    "@types/youtube": "^0.0.49",
    "@vitest/coverage-v8": "^3.0.7",
    "dat.gui": "^0.7.9",
    "happy-dom": "^17.4.4",
    "lit": "^3.2.1",
    "lottie-web": "^5.12.2",
    "sass": "^1.85.0",
    "three": "0.110.0",
    "tsup": "^8.3.6",
    "typedoc": "^0.27.9",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  },
  "peerDependencies": {
    "@github/details-dialog-element": "*",
    "angular": "*",
    "dat.gui": "*",
    "jquery": "*",
    "lit": "*",
    "lottie-web": "*",
    "pixi.js": "*",
    "three": "*"
  },
  "peerDependenciesMeta": {
    "@github/details-dialog-element": {
      "optional": true
    },
    "angular": {
      "optional": true
    },
    "dat.gui": {
      "optional": true
    },
    "jquery": {
      "optional": true
    },
    "lit": {
      "optional": true
    },
    "lottie-web": {
      "optional": true
    },
    "pixi.js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
